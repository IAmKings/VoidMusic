<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions per PRD §4.3 (privacy / local-first):
        - CAMERA: required (PRD F1.2). Used to frame the desk and detect objects/hands.
        - No INTERNET / no cloud: all vision + audio runs on-device.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        MediaPipe's transitive transport dependency declares network permissions.
        The app has no network feature, so remove them from the merged manifest
        and keep the distributed package aligned with the local-first promise.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Camera hardware requirement (PRD §4.2: rear camera needed). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.VoidMusic"
        tools:targetApi="31">

        <!--
            Single-Activity architecture (PRD §5.3). The Activity hosts all Compose screens.
            screenOrientation: user can rotate; lock not enforced at M0.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.VoidMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
